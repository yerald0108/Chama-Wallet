{
  "expo": {
    "name": "Chama",
    "slug": "chama",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "chama",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0A0F1E",
      "resizeMode": "contain"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0F1E"
      },
      "package": "com.chamaapp.wallet",
      "newArchEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ee727139-19e3-4e0d-8754-1d999e75b02a"
      }
    }
  }
}