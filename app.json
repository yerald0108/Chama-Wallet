{
  "expo": {
    "name": "Chama",
    "slug": "chama",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "chama",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0A0F1E",
      "resizeMode": "contain"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0F1E"
      },
      "package": "com.chamaapp.wallet"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}